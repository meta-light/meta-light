{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "noEmit": true,
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"]
  },
  "exclude": [
    "node_modules",
    "dist",
    "dist-carp",
    "src/database",
    "src/env.ts",
    "src/github",
    "src/news",
    "src/portfolio",
    "src/real-estate",
    "src/rentals",
    "src/scripts",
    "src/social",
    "src/trading",
    "src/utils",
    "src/ventures",
    "worker.ts"
  ]
}
