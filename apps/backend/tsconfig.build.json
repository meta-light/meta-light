{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "noEmit": true
  },
  "include": [
    "src/main.ts",
    "src/app.module.ts",
    "src/app.controller.ts",
    "src/app.service.ts",
    "src/common/**/*.ts",
    "src/auth/**/*.ts",
    "src/github/github.module.ts",
    "src/github/github.service.ts",
    "src/portfolio/portfolio.module.ts",
    "src/portfolio/portfolio.service.ts",
    "src/rentals/rentals.module.ts",
    "src/rentals/rentals.service.ts",
    "src/social/social.module.ts",
    "src/social/social.service.ts",
    "src/telegram/**/*.ts",
    "src/trading/trading.module.ts",
    "src/trading/trading.service.ts"
  ],
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
