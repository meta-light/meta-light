{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "packageManager": "bun@1.2.21",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "deploy": "bunx wrangler deploy",
    "secrets:sync": "doppler --config-dir \"${META_LIGHT_DOPPLER_CONFIG_DIR:-$HOME/.doppler-meta-light}\" secrets download --project carpcap --config prd --no-file --format json | bunx wrangler secret bulk",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "bash ../../scripts/with-secrets.sh bun src/main.ts",
    "start:dev": "bash ../../scripts/with-secrets.sh bun --watch src/main.ts",
    "start:debug": "bash ../../scripts/with-secrets.sh bun --inspect src/main.ts",
    "start:prod": "bash ../../scripts/with-secrets.sh bun src/main.ts",
    "db:ready": "bash ../../scripts/with-secrets.sh bun src/database/ready.ts",
    "lint": "oxlint --type-aware --ignore-pattern \"src/trading/legacy-code/**\" src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@meta-light/utils": "workspace:*",
    "@0dotxyz/p0-ts-sdk": "^2.1.0",
    "@composio/core": "^0.6.3",
    "@composio/openai": "^0.6.3",
    "@defillama/api": "^0.1.3",
    "@deserialize/swap-sdk": "^1.5.22",
    "@invariant-labs/sdk-eclipse": "^0.0.122",
    "@jup-ag/api": "^6.0.38",
    "@mendable/firecrawl-js": "^4.15.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@project-serum/anchor": "^0.26.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/web3.js": "^1.98.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/cheerio": "^0.22.35",
    "@x402/core": "^2.4.0",
