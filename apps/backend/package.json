{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "packageManager": "bun@1.2.21",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "deploy": "bunx wrangler deploy",
    "secrets:sync": "doppler --config-dir \"${META_LIGHT_DOPPLER_CONFIG_DIR:-$HOME/.doppler-meta-light}\" secrets download --project carpcap --config prd --no-file --format json | bunx wrangler secret bulk",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "bash ../../scripts/with-secrets.sh bun src/main.ts",
    "start:dev": "bash ../../scripts/with-secrets.sh bun --watch src/main.ts",
    "start:debug": "bash ../../scripts/with-secrets.sh bun --inspect src/main.ts",
    "start:prod": "bash ../../scripts/with-secrets.sh bun src/main.ts",
    "collect:once": "bash ../../scripts/with-secrets.sh bun src/collect/cli.ts",
    "paper": "bash ../../scripts/with-secrets.sh bun src/collect/cli.ts paper",
    "db:ready": "bash ../../scripts/with-secrets.sh bun src/database/ready.ts",
    "lint": "oxlint --type-aware src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@meta-light/utils": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@types/cheerio": "^0.22.35",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/isomorphic-fetch": "^0.0.39",
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/node-fetch": "^2.6.12",
    "@types/promise-retry": "^1.1.6",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
