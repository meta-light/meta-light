{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "meta-light-backend",
  "preview_urls": true,
  "account_id": "8d30ffea39fecfdeae9e886bcc25416a",
  "main": "worker.ts",
  "compatibility_date": "2026-11-11",
  "containers": [
    {
      "class_name": "BackendContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile",
          "build_context": "../.."
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BACKEND",
        "class_name": "BackendContainer"
      }
    ]
  },
  "exports": {
    "BackendContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "previews": {
    "containers": [
      {
        "class_name": "BackendContainer",
        "image": "./Dockerfile",
        "image_build_context": "../..",
        "instance_type": "lite",
        "max_instances": 1
      }
    ],
    "durable_objects": {
      "bindings": [
        {
          "name": "BACKEND",
          "class_name": "BackendContainer"
        }
      ]
    }
  }
}
