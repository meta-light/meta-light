{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "meta-light-backend",
  "preview_urls": true,
  "account_id": "8d30ffea39fecfdeae9e886bcc25416a",
  "main": "worker.ts",
  "compatibility_date": "2026-11-11",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "containers": [
    {
      "class_name": "BackendContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile",
          "build_context": "../.."
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BACKEND",
        "class_name": "BackendContainer"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carpcap",
      "database_id": "e841a129-90ea-4c93-af10-986951c62ae9"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *", "7 * * * *", "30 12 * * *", "0 14 * * *"]
  },
  "exports": {
    "BackendContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "carpcap",
        "database_id": "e841a129-90ea-4c93-af10-986951c62ae9"
      }
    ],
    "containers": [
      {
        "class_name": "BackendContainer",
        "image": "./Dockerfile",
        "image_build_context": "../..",
        "instance_type": "lite",
        "max_instances": 1
      }
    ],
    "durable_objects": {
      "bindings": [
        {
          "name": "BACKEND",
          "class_name": "BackendContainer"
        }
      ]
    }
  }
}
